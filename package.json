{
  "name": "universal-scraper",
  "version": "0.1.0",
  "description": "Agent-native web access: read, act, extract over one daemon",
  "type": "module",
  "bin": {
    "scraper": "dist/frontends/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/willweimike/universal-scraper.git"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run test:unit && npm run test:bdd",
    "test:unit": "vitest run",
    "test:bdd": "NODE_OPTIONS='--import tsx' cucumber-js",
    "build:plugin": "node scripts/build-plugin.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mozilla/readability": "^0.6.0",
    "@puppeteer/browsers": "^3.2.7",
    "commander": "^15.1.0",
    "jsdom": "^31.0.1",
    "puppeteer-core": "^25.17.0",
    "turndown": "^7.2.5",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
