# Bare Linux container: Node and nothing else (no curl, no wget). Proves an agent can do everything through the plugin.
FROM node:22-bookworm-slim
RUN rm -f /usr/bin/curl /usr/bin/wget
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# No setup step: the first browser read downloads the browser and installs its system libraries by itself (we are root here).
CMD ["npm", "run", "test:bdd", "--", "--profile", "container"]
